[Unit]
Description=PyPasteServer Clipboard Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
# Set to the user account that owns the PyPasteServer checkout
User=hoff
Group=hoff
# Path to the project checkout so python -m daemon resolves the package
WorkingDirectory=/home/hoff/swdev/PyPasteServer
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/home/hoff/swdev/PyPasteServer
ExecStartPre=/usr/bin/test -e /dev/kclip
ExecStart=/usr/bin/env venv/bin/python -m daemon
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
